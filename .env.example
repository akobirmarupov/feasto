# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.

# --- Asosiy ---
SECRET_KEY=o'zgartiring-uzun-tasodifiy-kalit
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Ma'lumotlar bazasi (PostgreSQL) ---
DB_NAME=feasto_db
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis (kesh, sessiya, Celery) ---
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# --- Frontend ---
# Google redirect oqimi tokenlarni shu sahifaga #fragment bilan qaytaradi.
FRONTEND_LOGIN_URL=http://localhost:3000/login
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Google orqali kirish (yagona ro'yxatdan o'tish yo'li) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram (admin guruhiga xabar: ariza, bron, obuna so'rovi, taklif). Bo'sh — o'chirilgan ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Push (Firebase Cloud Messaging HTTP v1). Bo'sh — o'chirilgan ---
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=

# --- Kuzatuv ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Kesh muddati (sekund) ---
CACHE_TTL_BUSINESS_LIST=60
CACHE_TTL_BUSINESS_DETAIL=120

# --- Production (DEBUG=False) ---
SECURE_SSL_REDIRECT=True
USE_PROXY_SSL_HEADER=True

# --- Media S3/MinIO (ixtiyoriy) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
