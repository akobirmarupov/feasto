[Unit]
Description=Feasto Celery worker
After=network.target redis.service postgresql.service

[Service]
User=feasto
Group=www-data
WorkingDirectory=/srv/feasto
EnvironmentFile=/srv/feasto/.env
ExecStart=/srv/feasto/venv/bin/celery -A config worker -l info --concurrency=2
Restart=always
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
