[Unit]
Description=Feasto API (gunicorn)
After=network.target postgresql.service redis.service

[Service]
User=feasto
Group=www-data
WorkingDirectory=/srv/feasto
EnvironmentFile=/srv/feasto/.env
ExecStart=/srv/feasto/venv/bin/gunicorn config.wsgi:application -c gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
