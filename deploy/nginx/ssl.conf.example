# ---------------------------------------------------------------------------
# Feasto, 2-BOSQICH: HTTPS.
# Sertifikat olingandan keyin shu fayl conf.d/default.conf ning
# o'rniga nusxalanadi.
# ---------------------------------------------------------------------------

upstream feasto_app {
    server web:8000;
    keepalive 32;
}

# --- 80-port: faqat yo'naltirish va sertifikat yangilash ---
server {
    listen 80 default_server;
    server_name api.feasto.uz;
    server_tokens off;

    # Sertifikat yangilash uchun. Redirect'dan YUQORIDA turishi shart,
    # aks holda certbot 301 ga urilib qoladi va yangilash ishlamaydi.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Qolgan hamma so'rov https ga.
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- 443-port: asosiy server ---
server {
    listen 443 ssl default_server;

    # nginx 1.25+ da http2 alohida direktiva.
    # Eski `listen 443 ssl http2;` yozuvi endi ogohlantirish beradi.
    http2 on;

    server_name api.feasto.uz;

    ssl_certificate     /etc/letsencrypt/live/api.feasto.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.feasto.uz/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS ni bu yerga YOZMANG. settings.py da DEBUG=False bo'lganda
    # SECURE_HSTS_SECONDS = 31536000 turibdi, Django o'zi yuboradi.
    # Ikkalasi yozsa javobda ikkita Strict-Transport-Security chiqadi.

    server_tokens off;
    client_max_body_size 20m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location /static/ {
        root /var/www;
        access_log off;
        gzip_static on;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /media/ {
        root /var/www;
        access_log off;
        add_header Cache-Control "public, max-age=2592000" always;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://feasto_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Endi $scheme = "https", Django buni to'g'ri tushunadi.
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-Forwarded-Host $host;
        proxy_redirect off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 65s;
        proxy_read_timeout 65s;
    }
}